# Development Dockerfile - runs dev server with hot reload
FROM node:22-alpine

WORKDIR /app

# Install bun globally
RUN npm install -g bun

# Copy package files
COPY package.json bun.lock ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy project files
COPY . .

# Expose port
EXPOSE 3000

# Run development server with hot reload
CMD ["bun", "run", "dev"]
