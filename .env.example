# ASR Service Environment Variables

# Qwen-ASR API Key (required for Qwen-ASR plugin)
QWEN_ASR_API_KEY=your_qwen_api_key_here

# Directory paths
UPLOAD_DIR=uploads
OUTPUT_DIR=output

# Default ASR method
DEFAULT_ASR_METHOD=whisper-api

# Path scanning configuration
# Comma-separated list of paths to scan for media files
# Example: SCAN_PATHS=/nas/media/audio,/nas/media/video
SCAN_PATHS=

# File extensions to scan for (comma-separated)
SCAN_FILE_EXTENSIONS=.mp3,.wav,.flac,.m4a,.aac,.ogg,.opus,.mp4,.avi,.mkv,.mov,.wmv,.flv,.webm

# Whether to scan recursively (true/false)
SCAN_RECURSIVE=true

# Maximum number of files to process in one scan
SCAN_MAX_FILES=100
